# Settings for running from source (copy to .env). The desktop app keeps these in home/settings.env
# and changes the common ones for you in Settings. Every value shown is the default.

AGENT_BACKEND=auto                 # auto (Claude if ANTHROPIC_API_KEY is set, else local) | local | claude | scripted
LOCAL_MODEL=qwen2.5:7b             # the app picks one that fits your computer's memory
LOCAL_PROVIDER=ollama              # ollama | openai (llama.cpp, LM Studio, vLLM...)
LOCAL_BASE_URL=http://localhost:11434
LOCAL_NUM_CTX=8192                 # context window (Ollama)
AGENT_WORKSPACE=workspace          # the only folder agents can change
AGENT_LOG_DIR=logs                 # transcripts + audit log
AGENTS_DIR=agents                  # your agents (the app's Agents tab saves here)

# Safety (see docs/SAFETY.md)
AGENT_AUTO_APPROVE=0               # 1 = never ask before risky actions (not recommended)
AGENT_SAFE_MODE=0                  # 1 = look-only agents: no writing or running anything
AGENT_SANDBOX=auto                 # auto | strict | limits
AGENT_REQUIRE_SANDBOX=0            # 1 = refuse commands unless strict isolation is available
AGENT_MIN_FREE_MB=1024             # stop writing when free disk space would drop below this
AGENT_ALLOW_PRIVATE_NETWORK=0      # 1 = web tools may reach your home network

# Online (optional)
# AGENT_CONTACT=you@example.com    # tells sites like Wikipedia who runs the agent (higher rate limits)
# SEARXNG_URL=http://localhost:8888   # your own search engine

# Claude (optional)
# ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium               # low | medium | high | xhigh | max
