# Copy to .env and edit. Every value shown is the default.
# None of these need an API key unless marked [Claude].

# auto = Claude if ANTHROPIC_API_KEY is set, otherwise the local model
# claude | local | scripted
AGENT_BACKEND=auto

# ---- Local model (REQUIRED for key-free use) ----
LOCAL_PROVIDER=ollama              # ollama | openai (llama.cpp, LM Studio, vLLM...)
LOCAL_BASE_URL=http://localhost:11434
LOCAL_MODEL=qwen2.5:7b
LOCAL_TOOL_MODE=auto               # auto | native | prompt
LOCAL_TIMEOUT=300                  # seconds; the first call loads the model
LOCAL_NUM_CTX=8192                 # context window (Ollama only)

# ---- Agent ----
AGENT_WORKSPACE=workspace          # sandbox folder for file tools
AGENT_MAX_STEPS=25
AGENT_AUTO_APPROVE=0               # 1 = never ask before shell/python/overwrite
AGENT_MAX_TOOL_OUTPUT=20000
AGENT_SHELL_TIMEOUT=60
AGENT_LOG_DIR=logs
# SEARXNG_URL=http://localhost:8888  # optional self-hosted search (no key)
# auto = "full" with Claude, "core" with local models.
# Or: minimal | core | research | coding | data | readonly | readonly_all | full
# Modifiers: core,+weather,-run_shell,@knowledge
AGENT_TOOL_PROFILE=auto

# ---- Council (multi-agent) ----
# COUNCIL_CONFIG=examples/council.local-only.json   # default: chair, researcher, skeptic, engineer
COUNCIL_WORKERS=1                  # members answering in parallel

# ---- [Claude] optional ----
# ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium               # low | medium | high | xhigh | max
CLAUDE_MAX_TOKENS=16000
CLAUDE_FALLBACKS=1                 # server-side refusal fallback
